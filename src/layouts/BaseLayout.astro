---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import BoidsBackground from '../components/BoidsBackground.astro';
import { site, socials } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} — ${site.title}`,
  description = site.description,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    {/* Must run before first paint, so: inline and blocking. `is:inline` keeps
        Astro from hoisting it into a deferred bundle, which would flash the
        wrong theme. Adding a CSP to public/_headers would require a hash here. */}
    <script is:inline>
      const stored = localStorage.getItem('theme');
      const theme =
        stored ??
        (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      document.documentElement.dataset.theme = theme;
      document.documentElement.style.colorScheme = theme;
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
  </head>

  <body class="min-h-screen antialiased">
    <BoidsBackground />
    <div class="grain" aria-hidden="true"></div>
    <Nav />

    <main class="pt-14">
      <slot />
    </main>

    <footer class="border-t border-line/60 bg-bg-hard/80">
      <div
        class="mx-auto flex max-w-5xl flex-col gap-4 px-6 py-10 text-sm text-fg-faint sm:flex-row sm:items-center sm:justify-between"
      >
        <p>
          &copy; {year} {site.fullName}.
          <span class="text-fg-dim">Built with Astro.</span>
        </p>
        <ul class="flex flex-wrap gap-4">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  class="text-fg-dim transition-colors hover:text-accent"
                  target={s.href.startsWith('http') ? '_blank' : undefined}
                  rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                >
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </footer>
  </body>
</html>
