---
import { nav } from '../data/site';
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-line/60 bg-bg-hard/80 backdrop-blur-sm"
>
  <nav
    class="mx-auto flex h-14 max-w-5xl items-center justify-between px-6"
    aria-label="Primary"
  >
    <a
      href="/"
      class="font-display text-lg font-bold uppercase tracking-tight text-fg transition-colors hover:text-accent"
    >
      LI<span class="text-accent">.</span>
    </a>

    <!-- Desktop links -->
    <ul class="hidden items-center gap-2 text-sm sm:flex">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="rounded-sm px-2 py-1 text-fg-dim transition-colors hover:text-accent"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Mobile toggle -->
    <button
      id="nav-toggle"
      type="button"
      class="flex h-9 w-9 items-center justify-center text-fg transition-colors hover:text-accent sm:hidden"
      aria-label="Toggle menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <svg
        class="icon-open h-6 w-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <line x1="3" y1="7" x2="21" y2="7"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="17" x2="21" y2="17"></line>
      </svg>
      <svg
        class="icon-close hidden h-6 w-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <line x1="5" y1="5" x2="19" y2="19"></line>
        <line x1="19" y1="5" x2="5" y2="19"></line>
      </svg>
    </button>
  </nav>

  <!-- Mobile menu panel -->
  <div
    id="mobile-menu"
    class="hidden border-t border-line/60 bg-bg-hard/95 sm:hidden"
  >
    <ul class="mx-auto flex max-w-5xl flex-col px-6 py-2">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="block border-b border-line/40 py-3 text-fg-dim transition-colors hover:text-accent"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = toggle?.querySelector('.icon-open');
  const iconClose = toggle?.querySelector('.icon-close');

  function setOpen(open: boolean) {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    menu.classList.toggle('hidden', !open);
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
  }

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  // Close after tapping a link.
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => setOpen(false)),
  );
</script>
