---
import { nav } from '../data/site';
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-line/60 bg-bg-hard/80 backdrop-blur-sm"
>
  <nav
    class="mx-auto flex h-14 max-w-5xl items-center justify-between px-6"
    aria-label="Primary"
  >
    <a
      href="/"
      class="font-display text-lg font-bold uppercase tracking-tight text-fg transition-colors hover:text-accent"
    >
      LI<span class="text-accent">.</span>
    </a>

    <!-- Desktop links -->
    <ul class="hidden items-center gap-2 text-sm sm:flex">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="rounded-sm px-2 py-1 text-fg-dim transition-colors hover:text-accent"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Mobile toggle -->
    <button
      id="nav-toggle"
      type="button"
      class="flex h-9 w-9 items-center justify-center text-fg transition-colors hover:text-accent sm:hidden"
      aria-label="Toggle menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <svg
        class="h-6 w-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <line class="bar-top" x1="3" y1="7" x2="21" y2="7"></line>
        <line class="bar-mid" x1="3" y1="12" x2="21" y2="12"></line>
        <line class="bar-bot" x1="3" y1="17" x2="21" y2="17"></line>
      </svg>
    </button>
  </nav>

  <!-- Mobile menu panel -->
  <div id="mobile-menu" class="grid sm:hidden" inert>
    <div class="min-h-0 overflow-hidden">
      <ul
        class="mx-auto flex max-w-5xl flex-col border-t border-line/60 bg-bg-hard/95 px-6 py-2"
      >
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="block border-b border-line/40 py-3 text-fg-dim transition-colors hover:text-accent"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</header>

<style>
  /* Collapse via grid track so the panel animates to its natural height.
     transform-box/origin pin the icon rotation to the viewBox centre. */
  #mobile-menu {
    grid-template-rows: 0fr;
    transition: grid-template-rows 220ms ease;
  }
  .nav-open #mobile-menu {
    grid-template-rows: 1fr;
  }

  #nav-toggle line {
    transform-box: view-box;
    transform-origin: 12px 12px;
    transition:
      transform 220ms ease,
      opacity 140ms ease;
  }
  .nav-open #nav-toggle .bar-top {
    transform: rotate(45deg) translateY(5px);
  }
  .nav-open #nav-toggle .bar-mid {
    opacity: 0;
  }
  .nav-open #nav-toggle .bar-bot {
    transform: rotate(-45deg) translateY(-5px);
  }

  @media (prefers-reduced-motion: reduce) {
    #mobile-menu,
    #nav-toggle line {
      transition-duration: 0s;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const header = toggle?.closest('header');

  function isOpen() {
    return toggle?.getAttribute('aria-expanded') === 'true';
  }

  function setOpen(open: boolean) {
    if (!toggle || !menu || !header) return;
    toggle.setAttribute('aria-expanded', String(open));
    header.classList.toggle('nav-open', open);
    // A collapsed grid track still leaves its links tabbable.
    menu.toggleAttribute('inert', !open);
  }

  toggle?.addEventListener('click', () => setOpen(!isOpen()));

  // Close after tapping a link.
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => setOpen(false)),
  );

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen()) {
      setOpen(false);
      toggle?.focus();
    }
  });

  // Desktop hides both the toggle and the panel; don't strand the open state.
  matchMedia('(min-width: 40rem)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>
