---
import SectionMark from './SectionMark.astro';
import { site, socials } from '../data/site';
---

<section id="contact" class="mx-auto max-w-5xl scroll-mt-20 px-6 py-24">
  <SectionMark index="06" label="Contact" />

  <div class="crop-marks grain relative border border-line bg-bg p-8 sm:p-12">
    <h2 class="text-4xl text-fg sm:text-6xl">
      Let's build something <span class="text-accent-display">reliable</span>.
    </h2>

    <p class="mt-6 max-w-2xl text-lg text-fg-dim">
      Open to DevOps, platform, and cloud engineering roles — remote-first.
      Reach out and I'll get back to you.
    </p>

    <a
      href={`mailto:${site.email}`}
      class="mt-8 inline-block font-display text-2xl text-accent underline decoration-line underline-offset-8 transition-colors hover:decoration-accent sm:text-3xl"
    >
      {site.email}
    </a>

    <ul class="mt-10 flex flex-wrap gap-4">
      {
        socials
          .filter((s) => s.label !== 'Email')
          .map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                class="border-2 border-line px-4 py-2 text-sm font-bold uppercase tracking-wider text-fg transition-colors hover:border-accent hover:text-accent"
              >
                {s.label}
              </a>
            </li>
          ))
      }
    </ul>
  </div>
</section>
