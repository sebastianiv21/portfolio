---
// Decorative ASCII flock (Reynolds boids) rendered to a fixed full-viewport
// canvas behind all content. Zero framework, runs client-side.
---

<canvas
  id="boids"
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 -z-10 h-full w-full opacity-40"
></canvas>

<script>
  type Boid = { x: number; y: number; vx: number; vy: number; tier: number };

  const canvas = document.getElementById('boids') as HTMLCanvasElement | null;
  const ctx = canvas?.getContext('2d') ?? null;
  if (canvas && ctx) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    // Gruvbox: yellow accent + dim foreground tones for depth.
    const COLORS = ['250,189,47', '215,153,33', '168,153,132'];

    let w = 0;
    let h = 0;
    let dpr = 1;
    let boids: Boid[] = [];
    let raf = 0;
    let last = 0;

    // Cursor (scatter target).
    const mouse = { x: -9999, y: -9999, active: false };
    let mouseIdle = 0;

    // Shared, slowly-drifting wind heading keeps the whole flock coherent.
    const wind = { x: 1, y: 0 };
    let windAngle = 0;
    let scrollBias = 0; // vertical nudge from scrolling

    const FONT_SIZE = 14;
    const PERCEPT = 72;
    const SEPARATION = 28;
    const MAX_SPEED = 1.6;
    const MAX_FORCE = 0.06;
    const MAX_FLEE_SPEED = 3.2;

    // behavior weights
    const W_ALIGN = 1.3;
    const W_COHESION = 0.9;
    const W_SEPARATION = 1.7;
    const W_WIND = 0.4;

    // cursor scatter
    const FLEE_R = 160;
    const FLEE_STRENGTH = 0.9;

    const rand = (a: number, b: number) => a + Math.random() * (b - a);

    function targetCount() {
      const area = w * h;
      const base = Math.round(area / 22000);
      const cap = w < 640 ? 30 : 90;
      return Math.max(12, Math.min(cap, base));
    }

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = window.innerWidth;
      h = window.innerHeight;
      canvas!.width = Math.floor(w * dpr);
      canvas!.height = Math.floor(h * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx!.font = `${FONT_SIZE}px "JetBrains Mono Variable", monospace`;
      ctx!.textAlign = 'center';
      ctx!.textBaseline = 'middle';

      const want = targetCount();
      while (boids.length < want) {
        // spawn already aligned-ish to the wind so it reads as a flock at once
        const a = windAngle + rand(-0.5, 0.5);
        boids.push({
          x: rand(0, w),
          y: rand(0, h),
          vx: Math.cos(a) * MAX_SPEED,
          vy: Math.sin(a) * MAX_SPEED,
          tier: Math.floor(Math.random() * COLORS.length),
        });
      }
      boids.length = want;
    }

    // Reynolds steering: turn a desired direction into a force limited to MAX_FORCE.
    function steer(dx: number, dy: number, b: Boid, out: { x: number; y: number }) {
      const m = Math.hypot(dx, dy);
      if (m === 0) {
        out.x = 0;
        out.y = 0;
        return;
      }
      let fx = (dx / m) * MAX_SPEED - b.vx;
      let fy = (dy / m) * MAX_SPEED - b.vy;
      const fm = Math.hypot(fx, fy);
      if (fm > MAX_FORCE) {
        fx = (fx / fm) * MAX_FORCE;
        fy = (fy / fm) * MAX_FORCE;
      }
      out.x = fx;
      out.y = fy;
    }

    const _s = { x: 0, y: 0 };

    function step(b: Boid) {
      let ax = 0;
      let ay = 0; // sum of neighbor velocities (alignment)
      let cx = 0;
      let cy = 0; // sum of neighbor positions (cohesion)
      let sx = 0;
      let sy = 0; // separation accumulator
      let n = 0;

      for (const o of boids) {
        if (o === b) continue;
        const dx = o.x - b.x;
        const dy = o.y - b.y;
        const d2 = dx * dx + dy * dy;
        if (d2 > 0 && d2 < PERCEPT * PERCEPT) {
          ax += o.vx;
          ay += o.vy;
          cx += o.x;
          cy += o.y;
          if (d2 < SEPARATION * SEPARATION) {
            const d = Math.sqrt(d2);
            sx -= dx / d / d; // weight away-vector by closeness
            sy -= dy / d / d;
          }
          n++;
        }
      }

      let accx = 0;
      let accy = 0;

      if (n > 0) {
        // alignment — the key fix for "pointing in all directions"
        steer(ax / n, ay / n, b, _s);
        accx += _s.x * W_ALIGN;
        accy += _s.y * W_ALIGN;
        // cohesion — toward neighbor center
        steer(cx / n - b.x, cy / n - b.y, b, _s);
        accx += _s.x * W_COHESION;
        accy += _s.y * W_COHESION;
        // separation
        if (sx !== 0 || sy !== 0) {
          steer(sx, sy, b, _s);
          accx += _s.x * W_SEPARATION;
          accy += _s.y * W_SEPARATION;
        }
      }

      // shared wind heading — coherent global drift
      steer(wind.x, wind.y, b, _s);
      accx += _s.x * W_WIND;
      accy += _s.y * W_WIND;

      b.vx += accx;
      b.vy += accy;

      // cursor scatter — applied straight to velocity, outside the MAX_FORCE clamp
      let speedCap = MAX_SPEED;
      if (mouse.active) {
        const dx = b.x - mouse.x;
        const dy = b.y - mouse.y;
        const d2 = dx * dx + dy * dy;
        if (d2 < FLEE_R * FLEE_R && d2 > 0) {
          const d = Math.sqrt(d2);
          const f = (1 - d / FLEE_R) ** 2 * FLEE_STRENGTH;
          b.vx += (dx / d) * f;
          b.vy += (dy / d) * f;
          speedCap = MAX_FLEE_SPEED; // let the veer-away be visibly faster
        }
      }

      // clamp speed (relaxed cap while fleeing)
      const sm = Math.hypot(b.vx, b.vy);
      if (sm > speedCap) {
        b.vx = (b.vx / sm) * speedCap;
        b.vy = (b.vy / sm) * speedCap;
      }

      b.x += b.vx;
      b.y += b.vy;

      // wrap
      const m = 16;
      if (b.x < -m) b.x = w + m;
      if (b.x > w + m) b.x = -m;
      if (b.y < -m) b.y = h + m;
      if (b.y > h + m) b.y = -m;
    }

    function draw() {
      ctx!.clearRect(0, 0, w, h);
      const t = performance.now();
      for (const b of boids) {
        const angle = Math.atan2(b.vy, b.vx);
        const speed = Math.hypot(b.vx, b.vy);
        const alpha = 0.4 + Math.min(speed / MAX_SPEED, 1) * 0.55;
        // wing-beat: wingtips rise and fall, phase offset per boid
        const flap = Math.sin(t / 160 + b.x * 0.04 + b.y * 0.04);
        const L = 4;
        const droop = (0.35 + flap * 0.5) * L;
        ctx!.save();
        ctx!.translate(b.x, b.y);
        ctx!.rotate(angle);
        ctx!.strokeStyle = `rgba(${COLORS[b.tier]},${alpha.toFixed(2)})`;
        ctx!.lineWidth = 1.1;
        ctx!.lineCap = 'round';
        ctx!.beginPath();
        // gull "M": wingtips trail back (-x), head leads (+x), wings curved
        ctx!.moveTo(-L, -droop);
        ctx!.quadraticCurveTo(0, -1, L * 0.6, 0);
        ctx!.quadraticCurveTo(0, 1, -L, droop);
        ctx!.stroke();
        ctx!.restore();
      }
    }

    function updateWind(t: number) {
      // slow wander: ~one full revolution per ~60s, plus scroll bias
      windAngle = Math.sin(t / 30000) * Math.PI;
      wind.x = Math.cos(windAngle);
      wind.y = Math.sin(windAngle) * 0.5 + scrollBias;
      scrollBias *= 0.95; // decay scroll nudge
    }

    function frame(t: number) {
      raf = requestAnimationFrame(frame);
      // throttle to ~30fps
      if (t - last < 33) return;
      last = t;
      if (mouse.active && t - mouseIdle > 300) mouse.active = false;
      updateWind(t);
      for (const b of boids) step(b);
      draw();
    }

    function start() {
      cancelAnimationFrame(raf);
      if (reduceMotion.matches) {
        updateWind(0);
        for (const b of boids) step(b);
        draw(); // single static frame
        return;
      }
      last = 0;
      raf = requestAnimationFrame(frame);
    }

    function stop() {
      cancelAnimationFrame(raf);
    }

    // ── listeners ──────────────────────────────────────────────────────
    window.addEventListener('resize', () => {
      resize();
      if (reduceMotion.matches) draw();
    });

    window.addEventListener('pointermove', (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
      mouse.active = true;
      mouseIdle = performance.now();
    });
    document.addEventListener('pointerleave', () => (mouse.active = false));

    let lastScroll = window.scrollY;
    window.addEventListener(
      'scroll',
      () => {
        const dy = window.scrollY - lastScroll;
        lastScroll = window.scrollY;
        scrollBias += Math.max(-0.6, Math.min(0.6, dy * 0.01));
      },
      { passive: true },
    );

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else if (!reduceMotion.matches) start();
    });

    reduceMotion.addEventListener('change', start);

    resize();
    start();
  }
</script>
