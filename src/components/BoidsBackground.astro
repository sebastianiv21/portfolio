---
// Decorative ASCII flock (Reynolds boids) rendered to a fixed full-viewport
// canvas behind all content. Zero framework, runs client-side.
---

<canvas
  id="boids"
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 -z-10 h-full w-full opacity-40"
></canvas>

<script>
  type Boid = { x: number; y: number; vx: number; vy: number; g: number };

  const canvas = document.getElementById('boids') as HTMLCanvasElement | null;
  const ctx = canvas?.getContext('2d') ?? null;
  if (canvas && ctx) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    // Gruvbox: yellow accent + dim foreground tones for depth.
    const COLORS = ['250,189,47', '215,153,33', '168,153,132'];
    // Bird-flight chevron glyphs, rotated to heading. Pure ASCII.
    const GLYPHS = ['>', '>', '»', 'v'];

    let w = 0;
    let h = 0;
    let dpr = 1;
    let boids: Boid[] = [];
    let raf = 0;
    let last = 0;
    const mouse = { x: -9999, y: -9999, active: false };
    let wind = 0; // horizontal drift driven by scroll

    const FONT_SIZE = 14;
    const PERCEPT = 64;
    const SEPARATION = 26;
    const MAX_SPEED = 1.15;
    const MAX_FORCE = 0.045;

    const rand = (a: number, b: number) => a + Math.random() * (b - a);

    function targetCount() {
      const area = w * h;
      const base = Math.round(area / 22000);
      const cap = w < 640 ? 30 : 90;
      return Math.max(12, Math.min(cap, base));
    }

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = window.innerWidth;
      h = window.innerHeight;
      canvas!.width = Math.floor(w * dpr);
      canvas!.height = Math.floor(h * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx!.font = `${FONT_SIZE}px "JetBrains Mono Variable", monospace`;
      ctx!.textAlign = 'center';
      ctx!.textBaseline = 'middle';

      const want = targetCount();
      while (boids.length < want) {
        const a = rand(0, Math.PI * 2);
        boids.push({
          x: rand(0, w),
          y: rand(0, h),
          vx: Math.cos(a) * MAX_SPEED,
          vy: Math.sin(a) * MAX_SPEED,
          g: Math.floor(Math.random() * GLYPHS.length),
        });
      }
      boids.length = want;
    }

    function step(b: Boid) {
      let ax = 0;
      let ay = 0; // alignment
      let cx = 0;
      let cy = 0; // cohesion
      let sx = 0;
      let sy = 0; // separation
      let n = 0;

      for (const o of boids) {
        if (o === b) continue;
        const dx = o.x - b.x;
        const dy = o.y - b.y;
        const d2 = dx * dx + dy * dy;
        if (d2 > 0 && d2 < PERCEPT * PERCEPT) {
          ax += o.vx;
          ay += o.vy;
          cx += o.x;
          cy += o.y;
          if (d2 < SEPARATION * SEPARATION) {
            const d = Math.sqrt(d2) || 1;
            sx -= dx / d;
            sy -= dy / d;
          }
          n++;
        }
      }

      let fx = wind;
      let fy = 0;
      if (n > 0) {
        // alignment
        fx += (ax / n) * 0.6;
        fy += (ay / n) * 0.6;
        // cohesion
        fx += (cx / n - b.x) * 0.0009;
        fy += (cy / n - b.y) * 0.0009;
        // separation
        fx += sx * 0.9;
        fy += sy * 0.9;
      }

      // cursor: gentle repulsion so the flock parts around the pointer
      if (mouse.active) {
        const dx = b.x - mouse.x;
        const dy = b.y - mouse.y;
        const d2 = dx * dx + dy * dy;
        const R = 120;
        if (d2 < R * R && d2 > 0) {
          const d = Math.sqrt(d2);
          const f = (1 - d / R) * 0.6;
          fx += (dx / d) * f;
          fy += (dy / d) * f;
        }
      }

      // clamp steering force
      const fm = Math.hypot(fx, fy);
      if (fm > MAX_FORCE) {
        fx = (fx / fm) * MAX_FORCE;
        fy = (fy / fm) * MAX_FORCE;
      }

      b.vx += fx;
      b.vy += fy;

      // clamp speed
      const sm = Math.hypot(b.vx, b.vy);
      if (sm > MAX_SPEED) {
        b.vx = (b.vx / sm) * MAX_SPEED;
        b.vy = (b.vy / sm) * MAX_SPEED;
      }

      b.x += b.vx;
      b.y += b.vy;

      // wrap
      const m = 16;
      if (b.x < -m) b.x = w + m;
      if (b.x > w + m) b.x = -m;
      if (b.y < -m) b.y = h + m;
      if (b.y > h + m) b.y = -m;
    }

    function draw() {
      ctx!.clearRect(0, 0, w, h);
      for (const b of boids) {
        const angle = Math.atan2(b.vy, b.vx);
        const speed = Math.hypot(b.vx, b.vy);
        const alpha = 0.4 + (speed / MAX_SPEED) * 0.55;
        ctx!.save();
        ctx!.translate(b.x, b.y);
        ctx!.rotate(angle);
        ctx!.fillStyle = `rgba(${COLORS[b.g % COLORS.length]},${alpha.toFixed(2)})`;
        ctx!.fillText(GLYPHS[b.g], 0, 0);
        ctx!.restore();
      }
    }

    function frame(t: number) {
      raf = requestAnimationFrame(frame);
      // throttle to ~30fps
      if (t - last < 33) return;
      last = t;
      wind *= 0.94; // decay scroll-driven drift
      for (const b of boids) step(b);
      draw();
    }

    function start() {
      cancelAnimationFrame(raf);
      if (reduceMotion.matches) {
        for (const b of boids) step(b);
        draw(); // single static frame
        return;
      }
      last = 0;
      raf = requestAnimationFrame(frame);
    }

    function stop() {
      cancelAnimationFrame(raf);
    }

    // ── listeners ──────────────────────────────────────────────────────
    window.addEventListener('resize', () => {
      resize();
      if (reduceMotion.matches) draw();
    });

    window.addEventListener('pointermove', (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
      mouse.active = true;
    });
    window.addEventListener('pointerleave', () => (mouse.active = false));

    let lastScroll = window.scrollY;
    window.addEventListener(
      'scroll',
      () => {
        const dy = window.scrollY - lastScroll;
        lastScroll = window.scrollY;
        wind += Math.max(-0.04, Math.min(0.04, dy * 0.002));
      },
      { passive: true },
    );

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else if (!reduceMotion.matches) start();
    });

    reduceMotion.addEventListener('change', start);

    resize();
    start();
  }
</script>
