---
import SectionMark from './SectionMark.astro';
import { skills } from '../data/site';
---

<section id="skills" class="mx-auto max-w-5xl scroll-mt-20 px-6 py-24">
  <SectionMark index="02" label="Stack" title="Tech Stack" />

  <div class="grid gap-px border border-line bg-line sm:grid-cols-2">
    {
      skills.map((group) => (
        <div class="bg-bg p-6">
          <h3 class="tech-label mb-4">{group.label}</h3>
          <ul class="flex flex-wrap gap-2">
            {group.items.map((item) => (
              <li class="border border-line px-3 py-1 text-sm text-fg-dim transition-colors hover:border-accent hover:text-fg">
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
